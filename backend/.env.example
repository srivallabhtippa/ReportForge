# Copy this file to .env and fill in the real values: cp .env.example .env
# .env is git-ignored. Never commit real passwords or keys.
DATABASE_URL=postgresql+psycopg://reportforge:YOUR_PASSWORD_HERE@localhost:5432/reportforge
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_value
APP_ENV=development

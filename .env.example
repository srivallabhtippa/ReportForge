# Used by docker compose. Copy to .env and fill in: cp .env.example .env
# .env is git-ignored. Never commit real passwords or keys.
# Generate each secret with: openssl rand -hex 24
POSTGRES_ADMIN_PASSWORD=replace_me
APP_DB_PASSWORD=replace_me
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_me
# Optional (these are the defaults):
# APP_DB_NAME=reportforge
# APP_DB_USER=reportforge
